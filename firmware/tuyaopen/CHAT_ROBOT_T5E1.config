# Custom Chat Robot T5-E1 board configuration.
# Copy into the target TuyaOpen/Wukong app config directory after integrating
# boards/T5AI/CHAT_ROBOT_T5E1 into the SDK's board choice.
CONFIG_BOARD_CHOICE_T5AI=y
CONFIG_BOARD_CHOICE_CHAT_ROBOT_T5E1=y
CONFIG_ENABLE_AUDIO_CODECS=y
CONFIG_ENABLE_AUDIO_AEC=y
CONFIG_AUDIO_CODEC_NAME="audio_codec"
CONFIG_BUTTON_NAME="ai_chat_button"
