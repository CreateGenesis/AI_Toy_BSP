+
+void chat_robot_dac_tone_loop(void)
+{
+    aud_dac_config_t dac_cfg = DEFAULT_AUD_DAC_CONFIG();
+    uint32_t writes = 0;
+    bk_err_t dac_rt;
+
+    dac_cfg.samp_rate = 16000;
+    dac_cfg.dac_gain = 0x3F;
+    dac_cfg.dac_chl = AUD_DAC_CHL_LR;
+    dac_cfg.work_mode = AUD_DAC_WORK_MODE_DIFFEN;
+    dac_rt = bk_aud_dac_init(&dac_cfg);
+    bk_printf("direct dac init %d\r\n", dac_rt);
+    bk_aud_dac_set_ana_gain(0x0F);
+    bk_aud_dac_unmute();
+    bk_aud_dac_start();
+    bk_printf("direct dac started\r\n");
+
+    while (1) {
+        uint32_t sample = ((writes % 16) < 8) ? 0x7FFF7FFF : 0x80008000;
+
+        if (bk_aud_dac_write(sample) != BK_OK) {
+            bk_printf("direct dac write fail at %u\r\n", writes);
+            tkl_system_sleep(20);
+            continue;
+        }
+        writes++;
+        if ((writes % 16000) == 0) {
+            bk_printf("direct dac writes %u\r\n", writes);
+        }
+    }
+}
 #endif
